# Copy to .env for local development. In production, set these as real
# environment variables on the host (Render, etc.) — never commit a real .env.

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/brandmarketian

# Required in production: a long random string. If unset, the server falls
# back to a hardcoded dev secret, which is unsafe to run publicly.
JWT_SECRET=

# Comma-separated list of allowed origins, e.g.:
# https://brandmarketian.com,https://admin.brandmarketian.com
CORS_ORIGIN=*

# SMTP (lead notification emails)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_TO=growth@brandmarketian.com

# WhatsApp lead notifications (optional)
WA_PHONE_ID=
WA_TOKEN=
WA_NOTIFY_TO=

# First admin user, created by `npm run seed`.
# Required in production: change the password from the default.
ADMIN_EMAIL=growth@brandmarketian.com
ADMIN_PASSWORD=

# Influencer/creator lookup provider: 'sample' | 'modash' | 'rapidapi'
CREATOR_PROVIDER=sample
MODASH_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=
CREATOR_CACHE_TTL_MS=86400000
