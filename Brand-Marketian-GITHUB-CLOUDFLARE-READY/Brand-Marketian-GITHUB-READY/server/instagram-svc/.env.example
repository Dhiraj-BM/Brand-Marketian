# Copy to .env  (this folder), then fill in. NEVER commit the real .env.
# python-dotenv is not loaded automatically here — either `export`/`set` these,
# or start the service with:  uvicorn main:app --env-file .env --port 8000
#
# You need ONE of the two auth methods below. Use a THROWAWAY Instagram
# account, never your brand's.

# --- METHOD 1 (preferred): sessionid cookie from a logged-in browser ---
# No password stored, no login challenge. To get it:
#   1. Log into instagram.com in a browser as the throwaway account
#   2. DevTools (F12) -> Application/Storage -> Cookies -> https://www.instagram.com
#   3. Copy the VALUE of the "sessionid" cookie, paste it here
# It looks like:  56281234%3AAbCdEf...%3A12%3AAY...
IG_SESSIONID=

# --- METHOD 2 (fallback): username + password ---
# Works, but the first login often triggers a "Was this you?" challenge that
# you must clear once in a browser, then restart this service.
IG_USERNAME=
IG_PASSWORD=

# --- optional ---
# Proxy for the Instagram traffic. Strongly recommended on a VPS / cloud host;
# usually not needed when running from a home connection. Format:
#   http://user:pass@host:port   or   socks5://user:pass@host:port
IG_PROXY=

# Where the login session is cached so it does not re-login every start.
IG_SESSION_FILE=session.json

# How many recent posts to sample for the engagement average.
IG_MEDIA_COUNT=12

# Shared secret with the Node API. If set here, set the SAME value as
# INSTAGRAM_SVC_TOKEN on the Node server, which will send it as x-svc-token.
SVC_TOKEN=
